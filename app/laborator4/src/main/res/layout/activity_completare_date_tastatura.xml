<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CompletareDateTastatura">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/completeaza_datele_tastaturii"
        />

    <EditText
        android:id="@+id/brandTastatura_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/numele_brandului"
        android:inputType="text"
        />

    <EditText
        android:id="@+id/numeTastatura_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/numele_tastaturii"
        android:inputType="text"
        />

    <CheckBox
        android:id="@+id/areTK_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/are_tenkey"
        />

    <CheckBox
        android:id="@+id/esteMecanica_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/este_mecanica"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selecteaza_culoarea_ledului"
        />

    <Spinner
        android:id="@+id/culoareLED_S"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selecteaza_tipul_de_switch"
        />

    <RadioGroup
        android:id="@+id/rg_culoare_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/radio_mxblue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mx_blue"
            />
        <RadioButton
            android:id="@+id/radio_mxred"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mx_red"
            />
        <RadioButton
            android:id="@+id/radio_mxblack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mx_black"
            />
    </RadioGroup>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="trimitereInformatii"
        android:text="@string/adaugare_informatii" />

</LinearLayout>